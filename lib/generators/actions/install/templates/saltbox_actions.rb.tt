# saltbox-actions settings. Each is a value, with a default that works for a
# plain Rails app; see Saltbox::Actions::Configuration for each one. What
# every call shares is app/actions/application_action.rb's.
Saltbox::Actions.configure do |config|
  # The optional adapters to load, in any order: only those listed load.
  # Uncomment each one the app uses and add the gem it names to the Gemfile;
  # a declared adapter whose gem is missing stops the boot. Declare at most
  # one of :pundit and :action_policy: the app's base action class includes it.
  config.adapters = [
<% adapter_lines.each do |line| -%>
    <%= line %>
<% end -%>
  ]

  # The app's name in tool titles, agent instructions and default messages.
  # config.app_name = "<%= app_name %>"

  # Sent to MCP agents after the gem's note on record data.
  # config.instructions = "Use find_action for anything not listed."
end

# The test helpers are not adapters to declare: require them in the test
# setup, as pundit/rspec is.
#   spec/rails_helper.rb:  require "saltbox/actions/adapters/testing/rspec"
#   test/test_helper.rb:   require "saltbox/actions/adapters/testing/minitest"
