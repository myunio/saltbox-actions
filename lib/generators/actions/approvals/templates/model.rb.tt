# One agent call to an action that asks first (agents :confirm), waiting for
# the person to approve it, or approved. The agent's first call is refused
# and saved here as a request; once the person approves it, the same call,
# with the same arguments from the same connection, runs once.
class ActionApproval < ApplicationRecord
  include Saltbox::Actions::Adapters::Confirmation::Approvals
<% if tenant && acts_as_tenant? -%>
  acts_as_tenant :<%= tenant %>
<% elsif tenant -%>
  # An approval is matched only within the current <%= tenant %>: scope it as
  # your other models are, such as with a default_scope on the current <%= tenant %>.
  belongs_to :<%= tenant %>
<% end -%>
<% unless approver == "user" -%>
  self.approver = :<%= approver %>
<% end -%>

  belongs_to :<%= approver %>
end
