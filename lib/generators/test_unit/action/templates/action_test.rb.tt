require "test_helper"
require "saltbox/actions/adapters/testing/minitest"

class <%= action_class_name %>Test < ActiveSupport::TestCase
  include Saltbox::Actions::Adapters::Testing::Minitest

  tests <%= action_class_name %>

  test "runs for a person who may use it" do
    # Replace these with fixtures or records from this app.
    user = permitted_user
<% if takes_id? -%>
    arguments = {id: visible_record.id.to_s}
<% else -%>
    arguments = {}
<% end -%>
    result = run_action(arguments, as: as_screen(user))
    assert_operator result.status, :<, 300
  end

  private

  def permitted_user
    raise NotImplementedError, "a person who may run <%= action_class_name %>"
  end
<% if takes_id? -%>

  def visible_record
    raise NotImplementedError, "a record the person can see"
  end
<% end -%>
end
