class <%= action_class_name %> < <%= base_class %>
<% declarations.each do |declaration| -%>
  <%= declaration %>
<% end -%>
<% if declarations.any? -%>

<% end -%>
  def perform
<% case body -%>
<% when "list" -%>
    <%= records %> = policy_scope(<%= model_name %>)
    render :index
<% when "plural" -%>
    authorize <%= model_name %>
    <%= records %> = policy_scope(<%= model_name %>)
    render :index
<% when "create" -%>
    @<%= record %> = policy_scope(<%= model_name %>).new(permitted_attributes(<%= model_name %>))
    authorize @<%= record %>
    @<%= record %>.save!
    render :show, status: :created
<% when "update" -%>
    <%= record %>.update!(permitted_attributes(<%= record %>))
    render :show
<% when "delete" -%>
    <%= record %>.destroy!
    head :no_content
<% else -%>
<% unless takes_id? -%>
    authorize <%= model_name %>
    skip_policy_scope
<% end -%>
    render :show
<% end -%>
  end
end
