require "rails_helper"

RSpec.describe <%= action_class_name %> do
  let(:permitted_account) { raise NotImplementedError, "a person who may run <%= action_class_name %>" }
<% if takes_id? -%>
  let(:<%= model.model_name.singular %>) { raise NotImplementedError, "<%= a_record %> the person can see" }
  let(:arguments) { {id: <%= model.model_name.singular %>.id} }
<% else -%>
  let(:arguments) { {} }
<% end -%>

  it "runs for the person on a screen" do
    result = run(arguments, as: as_screen(permitted_account))
    expect(result.status).to be < 300
  end

  # Each agent surface is refused or let through as `connections` says, and
  # a read-only token cannot change. When some people may not run the action
  # at all, define `unpermitted_account` too, and this refuses them.
  it_behaves_like "refuses callers the action does not allow"
<% if takes_id? -%>

  it_behaves_like "hides records the caller cannot see" do
    let(:hidden_arguments) { raise NotImplementedError, "arguments naming <%= a_record %> the person cannot see" }
  end
<% end -%>
end
