  {
    "name": "count_events",
    "title": "Count events",
    "description": "Use this when the person asks how many events there are, or how many have a status. Returns the count.",
    "kind": "read",
    "idempotent": true,
    "scope": "api:read",
    "connections": "allowed",
    "permissions": [
      "events.view"
    ],
    "permissions_any_of": [
      [
        "events.manage",
        "events.delete"
      ]
    ],
    "mcp_core": false,
    "cli": {
      "command": [
        "events",
        "count"
      ],
      "aliases": [
        [
          "events",
          "tally"
        ]
      ],
      "args": [
        "status"
      ],
      "columns": [
        "count"
      ]
    },
    "input_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Only events with this status",
          "enum": [
            "draft",
            "published",
            "cancelled"
          ]
        },
        "page": {
          "type": "integer",
          "description": "Page number, from 1",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        }
      },
      "required": [
        "count"
      ]
    }
  },
